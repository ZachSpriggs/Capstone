{
  "name": "decluttered-backend",
  "version": "1.0.0",
  "description": "Backend for the Decluttered capstone app (Express, Prisma, SQLite, JWT auth)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "prisma migrate dev --name init",
    "generate": "prisma generate",
    "test": "jest"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@tanstack/react-table": "^8.5.20",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.0.1",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "express-validator": "^7.2.1",
    "helmet": "^6.0.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.10",
    "@types/supertest": "^2.0.12",
    "jest": "^29.5.0",
    "prisma": "^6.11.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}

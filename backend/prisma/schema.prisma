datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  items          Item[]
  longTermGoals  LongTermGoal[]
}

model User {
  id             Int              @id @default(autoincrement())
  email          String           @unique
  password       String
  name           String
  items          Item[]
  goal           Goal?
  longTermGoals   LongTermGoal[]
}

model Item {
  id          Int       @id @default(autoincrement())
  name        String
  quantity    Int       @default(1)
  dateRemoved DateTime  @default(now())
  notes       String?
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  category     Category? @relation(fields: [categoryId], references: [id])
  categoryId   Int?
  createdAt DateTime @default(now())
}

model Goal {
  id        Int    @id @default(autoincrement())
  dailyGoal Int    @default(5)
  user      User   @relation(fields: [userId], references: [id])
  userId    Int    @unique
}

model LongTermGoal {
  id           Int       @id @default(autoincrement())
  description  String
  targetCount  Int
  category     Category  @relation(fields: [categoryId], references: [id])
  categoryId   Int
  user         User      @relation(fields: [userId], references: [id])
  userId       Int      
  createdAt    DateTime  @default(now())
}
